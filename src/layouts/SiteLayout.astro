---
import siteStyles from '../styles/site.css?url';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

export interface Props {
	lang: 'ja' | 'en';
	title: string;
	description: string;
	pageUrl: string;
	alternateJa: string;
	alternateEn: string;
	ogImage?: string;
	noindex?: boolean;
}

const {
	lang,
	title,
	description,
	pageUrl,
	alternateJa,
	alternateEn,
	ogImage,
	noindex = false,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const siteUrl = 'https://shadowharness.github.io/';
const resolvedOgImage = ogImage ?? (lang === 'ja' ? 'og-image.png?v=20260729e' : 'og-image-en.png?v=20260729e');
const otherLangUrl = lang === 'ja' ? alternateEn : alternateJa;
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#f4f1ea" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0b1014" media="(prefers-color-scheme: dark)" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<link rel="stylesheet" href={siteStyles} />
		{noindex && <meta name="robots" content="noindex" />}

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={pageUrl} />
		<link rel="alternate" hreflang="ja" href={alternateJa} />
		<link rel="alternate" hreflang="en" href={alternateEn} />
		<link rel="alternate" hreflang="x-default" href={alternateJa} />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:site_name" content="ShadowHarness" />
		<meta property="og:locale" content={lang === 'ja' ? 'ja_JP' : 'en_US'} />
		<meta property="og:image" content={`${siteUrl}${resolvedOgImage}`} />
		<meta property="og:image:alt" content="ShadowHarness" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@ShadowHarness" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${siteUrl}${resolvedOgImage}`} />

		<slot name="head-extra" />
	</head>
	<body>
		<a class="skip-link" href="#main-content">
			{lang === 'ja' ? '本文へ移動' : 'Skip to content'}
		</a>
		<SiteHeader lang={lang} otherLangUrl={otherLangUrl} />
		<slot />
		<SiteFooter lang={lang} />
	</body>
</html>
