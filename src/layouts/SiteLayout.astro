---
import '../styles/site.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

export interface Props {
	lang: 'ja' | 'en';
	title: string;
	description: string;
	pageUrl: string;
	alternateJa: string;
	alternateEn: string;
	noindex?: boolean;
}

const { lang, title, description, pageUrl, alternateJa, alternateEn, noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const siteUrl = 'https://shadowharness.github.io/';
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/png" href={`${base}shadow-icon.png`} />
		{noindex && <meta name="robots" content="noindex" />}

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={pageUrl} />
		<link rel="alternate" hreflang="ja" href={alternateJa} />
		<link rel="alternate" hreflang="en" href={alternateEn} />
		<link rel="alternate" hreflang="x-default" href={alternateJa} />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={`${siteUrl}og-image.png`} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@ShadowHarness" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${siteUrl}og-image.png`} />

		<slot name="head-extra" />
	</head>
	<body>
		<SiteHeader lang={lang} />
		<slot />
		<SiteFooter lang={lang} />
	</body>
</html>
