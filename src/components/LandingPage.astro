}

const { lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const isJa = lang === 'ja';
const guideUrl = isJa ? `${base}guide/` : `${base}en/guide/`;
const securityUrl = isJa ? `${base}security/` : `${base}en/security/`;

const copy = isJa
