---
import DemoDialog from './DemoDialog.astro';

interface Props {
	lang: 'ja' | 'en';
}

const { lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const isJa = lang === 'ja';
const guideUrl = isJa ? `${base}guide/` : `${base}en/guide/`;
const securityUrl = isJa ? `${base}security/` : `${base}en/security/`;
const demoId = isJa ? 'fbVTuTbw2ws' : 'jTfa8tup2-4';
const mediaVersion = '20260729g';

const copy = isJa
	? {
			stageLabel: 'SHADOW // MULTI-AGENT COMMAND',
			session: 'PRODUCT VIEW / LIVE',
			railLabel: 'VIEW',
			nav: {
				overview: '概要',
				workspace: '作業画面',
				memory: 'Sidera',
				demo: 'デモ',
			},
			pane: {
				overview: 'OVERVIEW / 実際の製品画面',
				workspace: 'WORKSPACE / 複数AIを一つの作業面へ',
				memory: 'SIDERA MEMORY / 記憶の構造',
				demo: 'LIVE DEMO / ノーカット実演',
			},
			statusReady: 'READY',
			overviewTitle: 'AIを替えても、仕事は同じ画面に残る。',
			overviewLead:
				'GPT / Codex、Claude Code、Grok、Geminiを、いつものまま一つのデスクトップへ。',
			overviewDemo: '実演を見る',
			overviewX: 'Xで開発を見る',
			overviewAlt:
				'ShadowHarnessの実画面。Explorer、Preview、複数のAIターミナル、Sidera Memoryが一つの画面に並ぶ',
			screenLabel: 'REAL PRODUCT / WINDOWS',
			agentLabel: 'AVAILABLE SESSIONS',
			workspaceTitle: '切り替えるのは、思考だけ。窓ではない。',
			workspaceLead:
				'資料、プレビュー、AIの会話、成果物を同じ作業面に置いたまま、使うAIだけを切り替えます。',
			workspaceAlt:
				'ShadowHarnessのPreview、OpenAI、ガイド、Sidera Memoryを同時に表示した実画面',
			workspaceFacts: [
				['CLI', 'GPT / Codex、Claude Code、Grok、Geminiを実ターミナルで起動'],
				['PANES', 'Explorer、Preview、Editor、AIを仕事に合わせて配置'],
				['CONTEXT', '作業と成果物を同じ机に残し、AIをまたいで継続'],
			],
			workspaceGuide: '製品ガイドを開く',
			memoryTitle: '記憶の変化と想起を、同じ空で見る。',
			memoryLead:
				'新しい情報が加わると星と関係線が組み替わり、必要な記憶が光とともに呼び戻されます。',
			memoryGuide: 'Sidera Memoryの仕組み',
			memoryPause: '動画を停止',
			memoryPlay: '動画を再生',
			selectClip: '主画面に表示',
			memoryClips: [
				{
					title: '星と配線が二度組み替わる',
					body: '更新直後に星と接続線が動き、続けてもう一度、別の配置へ組み替わります。',
					alt: 'Sidera Memoryで星と接続線が続けて二度再配置される実画面',
					video: 'sidera-memory-reformation.mp4',
					poster: 'sidera-memory-reformation-poster.webp',
				},
				{
					title: '記憶の全景',
					body: '複数AIの結論、経緯、根拠を一つの空で見渡します。',
					alt: 'Sidera Memoryの記憶の全景を移動しながら見る実画面',
					video: 'sidera-memory-loop.mp4',
					poster: 'sidera-memory-poster.webp',
				},
				{
					title: '想起が見える',
					body: '関連する星が光り、呼び戻された記憶がテキストで表示されます。',
					alt: 'Sidera Memoryで関連する星が光り、Current recallに想起テキストが現れる実画面',
					video: 'sidera-memory-recall.mp4',
					poster: 'sidera-memory-recall-poster.webp',
				},
			],
			demoTitle: '説明ではなく、実際の操作を。',
			demoLead:
				'複数AIの起動、ペインの整列、ファイル編集、AI補完、レンダーまで。実画面をノーカットで見せます。',
			demoButton: '3分の実演を再生',
			demoClose: '動画を閉じる',
			demoPosterAlt: 'ShadowHarness実演動画のプレビュー',
			demoMeta: '03:09 / 日本語 / 再生時のみYouTubeへ接続',
			trustTitle: 'DATA / TRUST',
			trustLead:
				'Sidera Memoryを有効にすると、対象CLIの新しい端末ログがShadow Hubへ送られ、記憶の構造化にLLMを使います。',
			trustFacts: [
				'構造化に送る入力は、モデル学習に使われない設定で処理',
				'各CLI提供元での扱いは、利用者自身の契約と設定に準拠',
			],
			trustLink: 'データの扱いを確認',
			guideLink: 'GUIDE',
		}
	: {
			stageLabel: 'SHADOW // MULTI-AGENT COMMAND',
			session: 'PRODUCT VIEW / LIVE',
			railLabel: 'VIEW',
			nav: {
				overview: 'Overview',
				workspace: 'Workspace',
				memory: 'Sidera',
				demo: 'Demo',
			},
			pane: {
				overview: 'OVERVIEW / THE REAL PRODUCT',
				workspace: 'WORKSPACE / MULTIPLE AIs, ONE DESK',
				memory: 'SIDERA MEMORY / MEMORY STRUCTURE',
				demo: 'LIVE DEMO / UNINTERRUPTED',
			},
			statusReady: 'READY',
			overviewTitle: 'Change the AI. Keep the work in place.',
			overviewLead:
				'Use GPT / Codex, Claude Code, Grok, and Gemini as they are—together on one desktop.',
			overviewDemo: 'Watch the demo',
			overviewX: 'Follow the build on X',
			overviewAlt:
				'The real ShadowHarness interface with Explorer, Preview, multiple AI terminals, and Sidera Memory on one screen',
			screenLabel: 'REAL PRODUCT / WINDOWS',
			agentLabel: 'AVAILABLE SESSIONS',
			workspaceTitle: 'Switch your thinking. Not your windows.',
			workspaceLead:
				'Keep source, preview, AI conversations, and outputs on the same work surface. Switch only the agent doing the work.',
			workspaceAlt:
				'The real ShadowHarness interface showing Preview, OpenAI, Guide, and Sidera Memory together',
			workspaceFacts: [
				['CLI', 'Run GPT / Codex, Claude Code, Grok, and Gemini in real terminals'],
				['PANES', 'Arrange Explorer, Preview, Editor, and AI around the task'],
				['CONTEXT', 'Keep the work and its outputs on one desk across agents'],
			],
			workspaceGuide: 'Open the product guide',
			memoryTitle: 'See memory change—and return when it matters.',
			memoryLead:
				'Stars and relation lines reform as memory changes. Relevant memories light up and appear in Current recall.',
			memoryGuide: 'How Sidera Memory works',
			memoryPause: 'Pause video',
			memoryPlay: 'Play video',
			selectClip: 'Show in main view',
			memoryClips: [
				{
					title: 'Stars and lines rearrange twice',
					body: 'Stars and connection lines shift after the update, then reform again into a second arrangement.',
					alt: 'The real Sidera Memory interface rearranging stars and connection lines twice in succession',
					video: 'sidera-memory-reformation.mp4',
					poster: 'sidera-memory-reformation-poster.webp',
				},
				{
					title: 'The memory field',
					body: 'Conclusions, changes, and evidence from multiple AIs share one field.',
					alt: 'Moving through the full field of memories in the real Sidera Memory interface',
					video: 'sidera-memory-loop.mp4',
					poster: 'sidera-memory-poster.webp',
				},
				{
					title: 'Recall becomes visible',
					body: 'Relevant stars light up and recalled text appears in Current recall.',
					alt: 'Relevant stars lighting up and recalled text appearing in Current recall in Sidera Memory',
					video: 'sidera-memory-recall.mp4',
					poster: 'sidera-memory-recall-poster.webp',
				},
			],
			demoTitle: 'See the operation—not a promise.',
			demoLead:
				'AI sessions launching, panes arranging, files editing, completion, and rendered output in one uninterrupted capture.',
			demoButton: 'Play the 3-minute demo',
			demoClose: 'Close video',
			demoPosterAlt: 'Preview of the ShadowHarness live product demo',
			demoMeta: '03:02 / English / YouTube connects only when played',
			trustTitle: 'DATA / TRUST',
			trustLead:
				'When Sidera Memory is enabled, new terminal-log content from covered CLIs is sent to Shadow Hub and LLM judgment helps structure it.',
			trustFacts: [
				'Structuring inputs are processed with model training disabled',
				'Each CLI provider follows the user’s own plan and settings',
			],
			trustLink: 'Review data handling',
			guideLink: 'GUIDE',
		};

const panes = [
	{ id: 'overview', code: 'OVR', label: copy.nav.overview },
	{ id: 'workspace', code: 'WRK', label: copy.nav.workspace },
	{ id: 'memory', code: 'MEM', label: copy.nav.memory },
	{ id: 'demo', code: 'RUN', label: copy.nav.demo },
];
const agents = ['GPT / Codex', 'Claude Code', 'Grok', 'Gemini'];
---

<main id="main-content" class="product-console" tabindex="-1" data-product-console>
	<section class="console-stage" aria-label={isJa ? 'ShadowHarness製品ショーケース' : 'ShadowHarness product showcase'}>
		<header class="console-titlebar">
			<span class="console-brandline"><i aria-hidden="true"></i>{copy.stageLabel}</span>
			<span class="console-session">{copy.session}</span>
			<span class="console-links">
				<a href={guideUrl}>{copy.guideLink}</a>
				<a href="https://x.com/ShadowHarness" target="_blank" rel="noopener">X ↗</a>
			</span>
		</header>

		<div class="console-body">
			<nav class="console-rail" role="tablist" aria-label={isJa ? '表示を切り替える' : 'Switch product view'}>
				<span class="rail-caption">{copy.railLabel}</span>
				{panes.map((pane, index) => (
					<button
						id={`stage-tab-${pane.id}`}
						type="button"
						role="tab"
						aria-selected={index === 0 ? 'true' : 'false'}
						aria-controls={pane.id}
						tabindex={index === 0 ? 0 : -1}
						data-pane-target={pane.id}
					>
						<span>{pane.code}</span>
						<strong>{pane.label}</strong>
					</button>
				))}
				<span class="rail-status"><i aria-hidden="true"></i>{copy.statusReady}</span>
			</nav>

			<div class="console-workspace">
				<article
					id="overview"
					class="console-pane console-pane-overview"
					role="tabpanel"
					aria-labelledby="stage-tab-overview"
					tabindex="0"
					data-stage-pane
				>
					<header class="pane-bar">
						<span><i aria-hidden="true"></i>{copy.pane.overview}</span>
						<span>01 / 04</span>
					</header>
					<div class="pane-canvas overview-canvas">
						<div class="overview-copy">
							<p class="console-kicker">SHADOWHARNESS / WINDOWS</p>
							<h1>{copy.overviewTitle}</h1>
							<p>{copy.overviewLead}</p>
							<div class="console-actions">
								<button type="button" class="console-action-primary" data-pane-target="demo">
									{copy.overviewDemo}<span aria-hidden="true">→</span>
								</button>
								<a href="https://x.com/ShadowHarness" target="_blank" rel="noopener">{copy.overviewX}<span aria-hidden="true">↗</span></a>
							</div>
						</div>
						<figure class="screen-frame overview-screen">
							<div class="screen-toolbar">
								<span><i></i><i></i><i></i></span>
								<strong>{copy.screenLabel}</strong>
								<em>1600 × 900</em>
							</div>
							<img
								src={`${base}media/hero-workspace.webp?v=${mediaVersion}`}
								alt={copy.overviewAlt}
								width="1600"
								height="900"
								fetchpriority="high"
								decoding="async"
							/>
							<figcaption>
								<span>{copy.agentLabel}</span>
								{agents.map((agent) => <strong>{agent}</strong>)}
							</figcaption>
						</figure>
					</div>
				</article>

				<article
					id="workspace"
					class="console-pane console-pane-workspace"
					role="tabpanel"
					aria-labelledby="stage-tab-workspace"
					tabindex="0"
					data-stage-pane
					hidden
				>
					<header class="pane-bar">
						<span><i aria-hidden="true"></i>{copy.pane.workspace}</span>
						<span>02 / 04</span>
					</header>
					<div class="pane-canvas workspace-canvas">
						<figure class="screen-frame workspace-screen">
							<div class="screen-toolbar">
								<span><i></i><i></i><i></i></span>
								<strong>SHADOW / ARRANGE</strong>
								<em>LIVE UI</em>
							</div>
							<img
								src={`${base}media/multi-agent-workspace-placeholder.webp?v=${mediaVersion}`}
								data-src={`${base}media/multi-agent-workspace.webp?v=${mediaVersion}`}
								alt={copy.workspaceAlt}
								width="1600"
								height="900"
								loading="eager"
								decoding="async"
							/>
						</figure>
						<aside class="workspace-inspector">
							<p class="console-kicker">ONE DESK</p>
							<h2>{copy.workspaceTitle}</h2>
							<p class="workspace-lead">{copy.workspaceLead}</p>
							<dl>
								{copy.workspaceFacts.map(([term, detail]) => (
									<div>
										<dt>{term}</dt>
										<dd>{detail}</dd>
									</div>
								))}
							</dl>
							<a class="inspector-link" href={guideUrl}>{copy.workspaceGuide}<span aria-hidden="true">↗</span></a>
						</aside>
					</div>
				</article>

				<article
					id="memory"
					class="console-pane console-pane-memory"
					role="tabpanel"
					aria-labelledby="stage-tab-memory"
					tabindex="0"
					data-stage-pane
					hidden
				>
					<header class="pane-bar pane-bar-memory">
						<span><i aria-hidden="true"></i>{copy.pane.memory}</span>
						<span>03 / 04</span>
					</header>
					<div class="pane-canvas memory-canvas">
						<header class="memory-heading">
							<div>
								<p class="console-kicker">SIDERA / MEMORY FIELD</p>
								<h2>{copy.memoryTitle}</h2>
							</div>
							<p>{copy.memoryLead}</p>
							<div class="memory-actions">
								<button
									type="button"
									data-sidera-motion-control
									data-pause-label={copy.memoryPause}
									data-play-label={copy.memoryPlay}
								>
									{copy.memoryPause}
								</button>
								<a href={`${guideUrl}#memory`}>{copy.memoryGuide}<span aria-hidden="true">↗</span></a>
							</div>
						</header>
						<div class="sidera-gallery" data-sidera-gallery>
							{copy.memoryClips.map((clip, index) => (
								<article
									class:list={['sidera-shot', { 'is-featured': index === 0 }]}
									data-sidera-shot
								>
									<button
										type="button"
										class="sidera-select"
										aria-pressed={index === 0 ? 'true' : 'false'}
										aria-label={`${clip.title} — ${copy.selectClip}`}
										data-sidera-select
									>
										<span class="sidera-media">
											<video
												muted
												loop
												playsinline
												preload="none"
												poster={`${base}media/${clip.poster.replace(/\.webp$/, '-placeholder.webp')}?v=${mediaVersion}`}
												data-poster={`${base}media/${clip.poster}?v=${mediaVersion}`}
												aria-label={clip.alt}
												data-sidera-video
												data-src={`${base}media/${clip.video}?v=${mediaVersion}`}
											></video>
											<span>SIDERA / {String(index + 1).padStart(2, '0')}</span>
										</span>
										<span class="sidera-copy">
											<strong>{clip.title}</strong>
											<small>{clip.body}</small>
										</span>
									</button>
								</article>
							))}
						</div>
					</div>
				</article>

				<article
					id="demo"
					class="console-pane console-pane-demo"
					role="tabpanel"
					aria-labelledby="stage-tab-demo"
					tabindex="0"
					data-stage-pane
					hidden
				>
					<header class="pane-bar pane-bar-demo">
						<span><i aria-hidden="true"></i>{copy.pane.demo}</span>
						<span>04 / 04</span>
					</header>
					<div class="pane-canvas demo-canvas">
						<div class="demo-stage">
							<DemoDialog
								videoId={demoId}
								title={copy.demoTitle}
								buttonLabel={copy.demoButton}
								closeLabel={copy.demoClose}
								posterSrc={`${base}media/${isJa ? 'demo-poster-ja-placeholder.webp' : 'demo-poster-en-placeholder.webp'}?v=${mediaVersion}`}
								posterFullSrc={`${base}media/${isJa ? 'demo-poster-ja.webp' : 'demo-poster-en.webp'}?v=${mediaVersion}`}
								posterAlt={copy.demoPosterAlt}
							/>
							<p class="demo-runtime">{copy.demoMeta}</p>
						</div>
						<aside class="demo-inspector">
							<p class="console-kicker">LIVE PRODUCT DEMO</p>
							<h2>{copy.demoTitle}</h2>
							<p class="demo-lead">{copy.demoLead}</p>
							<div class="trust-inline">
								<strong>{copy.trustTitle}</strong>
								<p>{copy.trustLead}</p>
								<ul>
									{copy.trustFacts.map((fact) => <li>{fact}</li>)}
								</ul>
								<a href={securityUrl}>{copy.trustLink}<span aria-hidden="true">↗</span></a>
							</div>
						</aside>
					</div>
				</article>
			</div>
		</div>
	</section>
</main>

<script>
	const consoleRoot = document.querySelector<HTMLElement>('[data-product-console]');

	if (consoleRoot) {
		const panes = Array.from(consoleRoot.querySelectorAll<HTMLElement>('[data-stage-pane]'));
		const tabs = Array.from(consoleRoot.querySelectorAll<HTMLButtonElement>('[role="tab"][data-pane-target]'));
		const paneIds = new Set(panes.map((pane) => pane.id));
		const canonicalPane = (value: string) => {
			const normalized = value.replace(/^#/, '').toLowerCase();
			if (normalized === 'sidera') return 'memory';
			return paneIds.has(normalized) ? normalized : 'overview';
		};

		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		const sideraVideos = Array.from(consoleRoot.querySelectorAll<HTMLVideoElement>('[data-sidera-video]'));
		const sideraShots = Array.from(consoleRoot.querySelectorAll<HTMLElement>('[data-sidera-shot]'));
		const motionControl = consoleRoot.querySelector<HTMLButtonElement>('[data-sidera-motion-control]');
		let motionPaused = reduceMotion.matches;

		const featuredVideo = () =>
			consoleRoot.querySelector<HTMLVideoElement>('[data-sidera-shot].is-featured [data-sidera-video]');

		const updateMotionLabel = () => {
			if (!motionControl) return;
			const featured = featuredVideo();
			const isPaused = motionPaused || !featured || featured.paused;
			motionControl.textContent = isPaused
				? (motionControl.dataset.playLabel ?? 'Play')
				: (motionControl.dataset.pauseLabel ?? 'Pause');
			motionControl.setAttribute('aria-pressed', isPaused ? 'false' : 'true');
		};

		const loadVideo = (video: HTMLVideoElement) => {
			if (!video.src && video.dataset.src) {
				video.src = video.dataset.src;
				video.load();
			}
		};

		const loadPaneImages = (paneId: string) => {
			const pane = document.getElementById(paneId);
			pane?.querySelectorAll<HTMLImageElement>('img[data-src]').forEach((image) => {
				const source = image.dataset.src;
				if (!source || image.dataset.loading === 'true') return;
				image.dataset.loading = 'true';
				const fullImage = new Image();
				fullImage.addEventListener(
					'load',
					() => {
						void fullImage
							.decode()
							.then(() => {
								image.src = source;
								delete image.dataset.src;
								delete image.dataset.loading;
							})
							.catch(() => {
								delete image.dataset.loading;
							});
					},
					{ once: true },
				);
				fullImage.addEventListener(
					'error',
					() => {
						delete image.dataset.loading;
					},
					{ once: true },
				);
				fullImage.src = source;
			});
		};

		const loadSideraPosters = () => {
			sideraVideos.forEach((video) => {
				const source = video.dataset.poster;
				if (!source || video.dataset.posterLoading === 'true') return;
				video.dataset.posterLoading = 'true';
				const poster = new Image();
				poster.addEventListener(
					'load',
					() => {
						void poster
							.decode()
							.then(() => {
								video.poster = source;
								delete video.dataset.poster;
								delete video.dataset.posterLoading;
							})
							.catch(() => {
								delete video.dataset.posterLoading;
							});
					},
					{ once: true },
				);
				poster.addEventListener(
					'error',
					() => {
						delete video.dataset.posterLoading;
					},
					{ once: true },
				);
				poster.src = source;
			});
		};

		const syncSideraPlayback = (paneId: string) => {
			const featured = featuredVideo();
			sideraVideos.forEach((video) => {
				if (video === featured && paneId === 'memory' && !motionPaused) {
					loadVideo(video);
					void video.play().catch(() => undefined);
				} else {
					video.pause();
				}
			});
			updateMotionLabel();
		};

		const activatePane = (
			requestedId: string,
			options: { updateHash?: boolean; focusTab?: boolean } = {},
		) => {
			const paneId = canonicalPane(requestedId);
			loadPaneImages(paneId);
			if (paneId === 'memory') loadSideraPosters();
			panes.forEach((pane) => {
				pane.hidden = pane.id !== paneId;
			});
			tabs.forEach((tab) => {
				const selected = tab.dataset.paneTarget === paneId;
				tab.setAttribute('aria-selected', selected ? 'true' : 'false');
				tab.tabIndex = selected ? 0 : -1;
				if (selected && options.focusTab) tab.focus();
			});
			syncSideraPlayback(paneId);
			if (options.updateHash && window.location.hash !== `#${paneId}`) {
				window.history.pushState({ pane: paneId }, '', `#${paneId}`);
			}
		};

		consoleRoot.querySelectorAll<HTMLElement>('[data-pane-target]').forEach((control) => {
			control.addEventListener('click', (event) => {
				event.preventDefault();
				const focusTab = control.getAttribute('role') !== 'tab' && event.detail === 0;
				activatePane(control.dataset.paneTarget ?? 'overview', { updateHash: true, focusTab });
			});
		});

		tabs.forEach((tab, index) => {
			tab.addEventListener('keydown', (event) => {
				let nextIndex: number | undefined;
				if (event.key === 'ArrowDown' || event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
				if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
				if (event.key === 'Home') nextIndex = 0;
				if (event.key === 'End') nextIndex = tabs.length - 1;
				if (nextIndex === undefined) return;
				event.preventDefault();
				activatePane(tabs[nextIndex].dataset.paneTarget ?? 'overview', {
					updateHash: true,
					focusTab: true,
				});
			});
		});

		document.addEventListener('click', (event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;
			const link = target.closest<HTMLAnchorElement>('a[href*="#"]');
			if (!link) return;
			const url = new URL(link.href, window.location.href);
			if (url.origin !== window.location.origin || url.pathname !== window.location.pathname) return;
			const targetId = url.hash.replace(/^#/, '').toLowerCase();
			if (targetId !== 'sidera' && !paneIds.has(targetId)) return;
			const paneId = canonicalPane(targetId);
			event.preventDefault();
			activatePane(paneId, { updateHash: true });
		});

		sideraShots.forEach((shot) => {
			const select = shot.querySelector<HTMLButtonElement>('[data-sidera-select]');
			select?.addEventListener('click', () => {
				const wasFeatured = shot.classList.contains('is-featured');
				sideraShots.forEach((candidate) => {
					const isFeatured = candidate === shot;
					candidate.classList.toggle('is-featured', isFeatured);
					candidate
						.querySelector<HTMLButtonElement>('[data-sidera-select]')
						?.setAttribute('aria-pressed', isFeatured ? 'true' : 'false');
				});
				const selectedVideo = shot.querySelector<HTMLVideoElement>('[data-sidera-video]');
				if (!wasFeatured && selectedVideo && Number.isFinite(selectedVideo.duration)) {
					selectedVideo.currentTime = 0;
				}
				motionPaused = reduceMotion.matches;
				syncSideraPlayback('memory');
			});
		});

		motionControl?.addEventListener('click', () => {
			motionPaused = !motionPaused;
			syncSideraPlayback('memory');
		});

		window.addEventListener('hashchange', () => activatePane(window.location.hash));
		window.addEventListener('popstate', () => activatePane(window.location.hash));
		reduceMotion.addEventListener('change', (event) => {
			motionPaused = event.matches;
			const activePane = panes.find((pane) => !pane.hidden)?.id ?? 'overview';
			syncSideraPlayback(activePane);
		});

		activatePane(window.location.hash);
	}
</script>
