const demoId = isJa ? 'fbVTuTbw2ws' : 'jTfa8tup2-4';
const mediaVersion = '20260729e';
---

<main id="main-content">
	<section class="hero">
		<div class="hero-copy">
			<p class="eyebrow">{copy.eyebrow}</p>
			<h1>
				<span>{copy.heroLine1}</span>
				<strong>{isJa ? <Fragment>ひとつの机と<br />記憶を。</Fragment> : copy.heroLine2}</strong>
			</h1>
			<p class="hero-lead">{copy.heroLead}</p>
			<div class="cta-row">
				<a class="button button-primary" href="#demo">{copy.demoCta}</a>
				<a class="button button-secondary" href="https://x.com/ShadowHarness" target="_blank" rel="noopener">
					{copy.xCta}
				</a>
			</div>
			<p class="status-note"><span aria-hidden="true"></span>{copy.heroNote}</p>
		</div>

		<div class="hero-stage">
			<div class="product-window product-window-hero">
				<div class="window-bar" aria-hidden="true">
					<span class="window-dots"><i></i><i></i><i></i></span>
					<span>{copy.windowTitle}</span>
				</div>
				<img
					src={`${base}media/hero-workspace.webp?v=${mediaVersion}`}
					alt={copy.workspaceAlt}
					width="1600"
					height="900"
					fetchpriority="high"
					decoding="async"
				/>
			</div>
			<span class="visual-note visual-note-a">{copy.visualNoteA}</span>
			<span class="visual-note visual-note-b">{copy.visualNoteB}</span>
		</div>

		<div class="agent-rail" aria-label={isJa ? '対応するAIの例' : 'Examples of supported AI tools'}>
			<span class="agent-rail-label">{isJa ? 'USE WHAT YOU ALREADY USE' : 'USE WHAT YOU ALREADY USE'}</span>
			{agents.map((agent) => <span>{agent}</span>)}
		</div>
	</section>

	<section class="product-story-section">
		<div class="section-shell">
			<div class="desk-showcase">
				<div class="section-heading section-heading-wide">
					<p class="eyebrow">{copy.manifestoEyebrow}</p>
					<h2>
						{isJa
							? <Fragment>切り替えるのは、<br />思考だけ。<br />窓ではない。</Fragment>
							: copy.manifestoTitle}
					</h2>
					<p>{copy.manifestoLead}</p>
				</div>
				<div class="desk-layout">
					<div class="product-window product-window-desk">
						<div class="window-bar" aria-hidden="true">
							<span class="window-dots"><i></i><i></i><i></i></span>
							<span>ShadowHarness / Multi-agent workspace</span>
						</div>
						<img
							src={`${base}media/multi-agent-workspace.webp?v=${mediaVersion}`}
							alt={copy.deskAlt}
							width="1600"
							height="900"
							loading="lazy"
							decoding="async"
						/>
					</div>
					<ol class="desk-index">
						{copy.deskItems.map((item) => (
							<li>
								<span>{item.no}</span>
								<div>
									<h3>{item.title}</h3>
									<p>{item.body}</p>
								</div>
							</li>
						))}
					</ol>
				</div>
			</div>

			<div id="memory" class="memory-panel">
				<div class="memory-panel-heading">
					<div>
						<p class="eyebrow">{copy.memoryEyebrow}</p>
						<h2>
							{isJa
								? <Fragment>記憶は、履歴の山ではなく、<br />次の判断になる。</Fragment>
								: copy.memoryTitle}
						</h2>
					</div>
					<p class="memory-lead">{copy.memoryLead}</p>
					<div class="memory-copy">
						<ol class="memory-steps">
							{copy.memorySteps.map(([title, body], index) => (
								<li>
									<span>{String(index + 1).padStart(2, '0')}</span>
									<div>
										<h3>{title}</h3>
										<p>{body}</p>
									</div>
								</li>
							))}
						</ol>
						<a class="text-link text-link-light" href={`${guideUrl}#memory`}>{copy.memoryLink}<span>↗</span></a>
					</div>
				</div>
				<div class="memory-panel-body">
					<div class="memory-visual">
						<div class="memory-orbit" aria-hidden="true"></div>
						<div class="memory-gallery">
							{copy.memoryClips.map((clip, index) => (
								<figure class:list={['memory-clip', { 'memory-clip-featured': index === 0 }]}>
									<div class="memory-clip-media">
										<video
											id={`sidera-memory-motion-${index + 1}`}
											autoplay
											muted
											loop
											playsinline
											preload="none"
											poster={`${base}media/${clip.poster}?v=${mediaVersion}`}
											aria-label={clip.alt}
											data-ambient-video
											data-src={`${base}media/${clip.video}?v=${mediaVersion}`}
										></video>
										<button
											type="button"
											class="memory-motion-control"
											aria-controls={`sidera-memory-motion-${index + 1}`}
											data-motion-control
											data-pause-label={copy.memoryPause}
											data-play-label={copy.memoryPlay}
											hidden
										>
											{copy.memoryPause}
										</button>
									</div>
									<figcaption>
										<span>SIDERA / {String(index + 1).padStart(2, '0')}</span>
										<strong>{clip.title}</strong>
										<p>{clip.body}</p>
									</figcaption>
								</figure>
							))}
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section id="demo" class="closing-section">
		<div class="section-shell">
			<div class="demo-heading">
				<div>
					<p class="eyebrow">{copy.demoEyebrow}</p>
					<h2>
						{isJa ? <Fragment>説明ではなく、<br />実際の画面を。</Fragment> : copy.demoTitle}
					</h2>
				</div>
				<p>{copy.demoLead}</p>
			</div>
			<div class="demo-trust-grid">
				<div class="demo-product">
					<DemoDialog
						videoId={demoId}
						title={copy.demoTitle}
						buttonLabel={copy.demoButton}
						closeLabel={copy.demoClose}
						posterSrc={`${base}media/${isJa ? 'demo-poster-ja.webp' : 'demo-poster-en.webp'}?v=${mediaVersion}`}
						posterAlt={copy.demoPosterAlt}
					/>
					<p class="demo-meta">{copy.demoMeta}</p>
				</div>
				<aside class="trust-card" aria-labelledby="trust-heading">
					<p class="eyebrow">{copy.trustEyebrow}</p>
					<h2 id="trust-heading">{copy.trustTitle}</h2>
					<p class="trust-lead">{copy.trustLead}</p>
					<ul>
						{copy.trustFacts.map((fact) => <li>{fact}</li>)}
					</ul>
					<a class="text-link" href={securityUrl}>{copy.trustLink}<span>↗</span></a>
				</aside>
			</div>
			<div class="follow-card">
				<div class="final-glow" aria-hidden="true"></div>
				<div>
					<p class="eyebrow">{copy.finalEyebrow}</p>
					<h2>{copy.finalTitle}</h2>
					<p>{copy.finalLead}</p>
				</div>
				<div class="cta-row">
					<a class="button button-inverse" href="https://x.com/ShadowHarness" target="_blank" rel="noopener">
						{copy.finalX}
					</a>
					<a class="button button-dark-ghost" href="https://www.youtube.com/@ShadowHarness" target="_blank" rel="noopener">
						{copy.finalYouTube}
					</a>
				</div>
			</div>
		</div>
	</section>
</main>

<script>
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	document.querySelectorAll<HTMLVideoElement>('[data-ambient-video]').forEach((video) => {
		const control = video.parentElement?.querySelector<HTMLButtonElement>('[data-motion-control]');
		const updateControl = () => {
			if (!control) return;
			control.textContent = video.paused
				? (control.dataset.playLabel ?? 'Play')
				: (control.dataset.pauseLabel ?? 'Pause');
		};

		control?.addEventListener('click', () => {
			if (video.paused) {
				void video.play().then(updateControl).catch(updateControl);
			} else {
				video.pause();
				updateControl();
			}
		});
		video.addEventListener('play', updateControl);
		video.addEventListener('pause', updateControl);

		const loadMedia = () => {
			if (video.dataset.poster) video.poster = video.dataset.poster;
			if (reduceMotion.matches) {
				video.pause();
				video.removeAttribute('autoplay');
				if (control) control.hidden = true;
				return;
			}
			if (video.dataset.src && !video.src) {
				video.src = video.dataset.src;
				video.load();
				if (control) control.hidden = false;
				void video.play().then(updateControl).catch(updateControl);
			}
		};

		if ('IntersectionObserver' in window) {
			const observer = new IntersectionObserver(
				(entries) => {
					if (entries.some((entry) => entry.isIntersecting)) {
						loadMedia();
						observer.disconnect();
					}
				},
				{ rootMargin: '600px 0px' },
			);
			observer.observe(video);
		} else {
			loadMedia();
		}
	});
</script>
