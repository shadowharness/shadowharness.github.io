				},
				{
					no: '03',
					title: 'Parallel, without the sprawl',
					body: 'Run several agents at once while keeping responsibilities and outputs on the same work surface.',
				},
			],
			memoryEyebrow: 'SIDERA MEMORY',
			memoryTitle: 'Memory should become the next decision—not a pile of history.',
			memoryLead:
				'Sidera does more than remember. It preserves the current conclusion, what changed, and the evidence behind it—then returns only what matters now.',
			memoryAlt: 'Sidera Memory rebuilding a field of memories and lighting up the relevant ones',
			memoryPause: 'Pause animation',
			memoryPlay: 'Play animation',
			memoryClips: [
				{
					title: 'Stars and connections rearrange',
					body: 'When memory updates, stars move to new positions and their connection lines follow the same endpoints.',
					alt: 'Stars moving to new positions as their connection lines rearrange during a Sidera Memory update',
