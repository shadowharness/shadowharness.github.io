---
export interface Props {
	lang: 'ja' | 'en';
}
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const homeUrl = lang === 'ja' ? `${base}ja/` : base;
const guideUrl = lang === 'ja' ? `${base}guide/` : `${base}en/guide/`;
const securityUrl = lang === 'ja' ? `${base}security/` : `${base}en/security/`;
---

<footer class="site-footer">
	<div class="footer-brand">
		<a class="brand" href={homeUrl}>
			<span class="brand-mark" aria-hidden="true">S</span>
			<span>ShadowHarness</span>
		</a>
		<p>
			{lang === 'ja' ? 'AIエージェントに、ひとつの机と記憶を。' : 'One desk. One memory. Every AI agent.'}
		</p>
	</div>
	<nav aria-label={lang === 'ja' ? 'フッターナビゲーション' : 'Footer navigation'}>
		<a href={guideUrl}>{lang === 'ja' ? 'ガイド' : 'Guide'}</a>
		<a href={`${homeUrl}#demo`}>{lang === 'ja' ? 'デモ' : 'Demo'}</a>
		<a href={securityUrl}>{lang === 'ja' ? 'データと信頼性' : 'Data & Trust'}</a>
		<a href="https://x.com/ShadowHarness" target="_blank" rel="noopener">X</a>
		<a href="https://www.youtube.com/@ShadowHarness" target="_blank" rel="noopener">YouTube</a>
	</nav>
	<p class="copyright">© 2026 ShadowHarness</p>
</footer>
