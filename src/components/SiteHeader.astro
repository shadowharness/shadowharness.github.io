---
export interface Props {
	lang: 'ja' | 'en';
}
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL;

const homeUrl = lang === 'ja' ? base : `${base}en/`;
const otherLangUrl = lang === 'ja' ? `${base}en/` : base;
const securityUrl = lang === 'ja' ? `${base}security/` : `${base}en/security/`;

const nav =
	lang === 'ja'
		? [
				{ href: `${homeUrl}#concept`, label: 'コンセプト' },
				{ href: `${homeUrl}#memory`, label: '記憶' },
				{ href: `${homeUrl}#editor`, label: 'エディタ' },
				{ href: securityUrl, label: '安心' },
				{ href: `${homeUrl}#demo`, label: 'デモ' },
			]
		: [
				{ href: `${homeUrl}#concept`, label: 'Concept' },
				{ href: `${homeUrl}#memory`, label: 'Memory' },
				{ href: `${homeUrl}#editor`, label: 'Editor' },
				{ href: securityUrl, label: 'Trust' },
				{ href: `${homeUrl}#demo`, label: 'Demo' },
			];
---

<header class="site-header">
	<a class="brand" href={homeUrl}>SHADOW</a>
	<nav>
		{nav.map((item) => <a href={item.href}>{item.label}</a>)}
	</nav>
	<span class="header-links">
		<a class="lang-link" href={otherLangUrl}>{lang === 'ja' ? 'EN' : '日本語'}</a>
		<a class="x-link" href="https://x.com/ShadowHarness" target="_blank" rel="noopener">
			𝕏 @ShadowHarness
		</a>
	</span>
</header>
