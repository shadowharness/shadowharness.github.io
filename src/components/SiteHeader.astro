---
export interface Props {
	lang: 'ja' | 'en';
	otherLangUrl?: string;
}
const { lang, otherLangUrl: alternateLanguageUrl } = Astro.props;
const base = import.meta.env.BASE_URL;

const homeUrl = lang === 'ja' ? `${base}ja/` : base;
const otherLangUrl = alternateLanguageUrl ?? (lang === 'ja' ? base : `${base}ja/`);
const otherLang = lang === 'ja' ? 'en' : 'ja';
const languageLabel = lang === 'ja' ? '英語版へ切り替え: English' : 'Switch to 日本語';
const guideUrl = lang === 'ja' ? `${base}guide/` : `${base}en/guide/`;

const nav =
	lang === 'ja'
		? [
				{ href: guideUrl, label: 'ガイド' },
				{ href: `${homeUrl}#memory`, label: '記憶' },
				{ href: `${homeUrl}#demo`, label: 'デモ' },
			]
		: [
				{ href: guideUrl, label: 'Guide' },
				{ href: `${homeUrl}#memory`, label: 'Memory' },
				{ href: `${homeUrl}#demo`, label: 'Demo' },
			];
---

<header class="site-header">
	<a class="brand" href={homeUrl}>
		<span class="brand-mark" aria-hidden="true">S</span>
		<span>ShadowHarness</span>
	</a>
	<nav class="desktop-nav" aria-label={lang === 'ja' ? 'メインナビゲーション' : 'Primary navigation'}>
		{nav.map((item) => <a href={item.href}>{item.label}</a>)}
		<a href="https://x.com/ShadowHarness" target="_blank" rel="noopener">X</a>
	</nav>
	<span class="header-links">
		<a
			class="lang-link"
			href={otherLangUrl}
			hreflang={otherLang}
			aria-label={languageLabel}
			data-language-link
		>
			<span lang={otherLang}>{lang === 'ja' ? 'English' : '日本語'}</span>
		</a>
	</span>
	<details class="mobile-menu">
		<summary aria-label={lang === 'ja' ? 'メニュー' : 'Menu'}>
			<span></span><span></span>
		</summary>
		<nav aria-label={lang === 'ja' ? 'モバイルナビゲーション' : 'Mobile navigation'}>
			{nav.map((item) => <a href={item.href}>{item.label}</a>)}
			<a href="https://x.com/ShadowHarness" target="_blank" rel="noopener">X</a>
		</nav>
	</details>
</header>

<script>
	const languageLink = document.querySelector<HTMLAnchorElement>('[data-language-link]');
	if (languageLink) {
		const destination = new URL(languageLink.href);
		const updateLanguageLink = () => {
			languageLink.href = `${destination.pathname}${destination.search}${window.location.hash}`;
		};
		const updateAfterPaneChange = (event: Event) => {
			if (event.target instanceof Element && event.target.closest('[data-pane-target]')) {
				queueMicrotask(updateLanguageLink);
			}
		};
		updateLanguageLink();
		window.addEventListener('hashchange', updateLanguageLink);
		window.addEventListener('popstate', updateLanguageLink);
		document.addEventListener('click', updateAfterPaneChange);
		document.addEventListener('keydown', updateAfterPaneChange);
	}

	document.querySelectorAll<HTMLDetailsElement>('.mobile-menu').forEach((menu) => {
		const summary = menu.querySelector<HTMLElement>('summary');
		menu.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape' || !menu.open) return;
			menu.open = false;
			summary?.focus();
		});
		menu.addEventListener('click', (event) => {
			if (!(event.target instanceof Element) || !event.target.closest('a')) return;
			menu.open = false;
			summary?.focus();
		});
		document.addEventListener('pointerdown', (event) => {
			if (menu.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
		});
	});
</script>
