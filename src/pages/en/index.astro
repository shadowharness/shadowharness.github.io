---
import LandingPage from '../../components/LandingPage.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';

const siteUrl = 'https://shadowharness.github.io/';
const title = 'ShadowHarness — One desk and one memory for every AI agent';
const description =
	'Bring GPT / Codex, Claude Code, Grok, Gemini and more into one Windows workspace where work and memory carry across agents.';
---

<SiteLayout
	lang="en"
	title={title}
	description={description}
	pageUrl={siteUrl}
	alternateJa={`${siteUrl}ja/`}
	alternateEn={siteUrl}
	noindex
>
	<Fragment slot="head-extra">
		<link
			rel="preload"
			as="image"
			href="/media/hero-workspace.webp?v=20260729g"
			imagesrcset="/media/hero-workspace-400.webp?v=20260729g 400w, /media/hero-workspace-800.webp?v=20260729g 800w, /media/hero-workspace-960.webp?v=20260729g 960w, /media/hero-workspace.webp?v=20260729g 1600w"
			imagesizes="(max-width: 760px) calc(100vw - 28px), (max-width: 1100px) and (max-aspect-ratio: 11 / 10) calc(100vw - 30px), (max-width: 1100px) 60vw, 58vw"
			type="image/webp"
			fetchpriority="high"
		/>
		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				'@context': 'https://schema.org',
				'@type': 'SoftwareApplication',
				name: 'ShadowHarness',
				applicationCategory: 'DeveloperApplication',
				operatingSystem: 'Windows',
				description,
				url: siteUrl,
				image: `${siteUrl}og-image-en.png?v=20260729e`,
				author: { '@type': 'Organization', name: 'ShadowHarness' },
			})}
		/>
	</Fragment>
	<LandingPage lang="en" />
</SiteLayout>
