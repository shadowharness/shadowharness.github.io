---
import LandingPage from '../../components/LandingPage.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';

const siteUrl = 'https://shadowharness.github.io/';
const pageUrl = `${siteUrl}en/`;
const title = 'ShadowHarness — One desk and one memory for every AI agent';
const description =
	'Bring GPT / Codex, Claude Code, Grok, Gemini and more into one Windows workspace where work and memory carry across agents.';
---

<SiteLayout
	lang="en"
	title={title}
	description={description}
	pageUrl={pageUrl}
	alternateJa={siteUrl}
	alternateEn={pageUrl}
>
	<Fragment slot="head-extra">
		<link rel="preload" as="image" href="/media/hero-workspace.webp?v=20260729f" type="image/webp" fetchpriority="high" />
		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				'@context': 'https://schema.org',
				'@type': 'SoftwareApplication',
				name: 'ShadowHarness',
				applicationCategory: 'DeveloperApplication',
				operatingSystem: 'Windows',
				description,
				url: pageUrl,
				image: `${siteUrl}og-image-en.png?v=20260729e`,
				author: { '@type': 'Organization', name: 'ShadowHarness' },
			})}
		/>
	</Fragment>
	<LandingPage lang="en" />
</SiteLayout>
