---
import SiteLayout from '../layouts/SiteLayout.astro';

const siteUrl = 'https://shadowharness.github.io/';
const base = import.meta.env.BASE_URL;
const title = '404 — ShadowHarness';
const description = 'The requested page could not be found.';
---

<SiteLayout
	lang="en"
	title={title}
	description={description}
	pageUrl={siteUrl}
	alternateJa={`${siteUrl}ja/`}
	alternateEn={siteUrl}
	noindex
>
	<main id="main-content" class="error-page" tabindex="-1">
		<p class="eyebrow">404 / NOT FOUND</p>
		<h1>Page not found.</h1>
		<p>The requested page could not be found.</p>
		<div class="cta-row">
			<a class="button button-primary" href={base}>Back to home</a>
			<a class="button button-secondary" href={`${base}ja/`} hreflang="ja"
				><span lang="ja">日本語</span></a
			>
		</div>
	</main>
</SiteLayout>
