---
import SiteLayout from '../layouts/SiteLayout.astro';

const siteUrl = 'https://shadowharness.github.io/';
const base = import.meta.env.BASE_URL;
const title = '404 — ShadowHarness';
const description = 'The requested page could not be found.';
---

<SiteLayout
	lang="ja"
	title={title}
	description={description}
	pageUrl={siteUrl}
	alternateJa={siteUrl}
	alternateEn={`${siteUrl}en/`}
	noindex
>
	<main id="main-content" class="error-page" tabindex="-1">
		<p class="eyebrow">404 / NOT FOUND</p>
		<h1>このページは、<br /><span>まだ記憶にありません。</span></h1>
		<p>The requested page could not be found.</p>
		<div class="cta-row">
			<a class="button button-primary" href={base}>トップへ戻る</a>
			<a class="button button-secondary" href={`${base}en/`}>English</a>
		</div>
	</main>
</SiteLayout>
