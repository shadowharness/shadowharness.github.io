---
import SiteLayout from '../layouts/SiteLayout.astro';

const siteUrl = 'https://shadowharness.github.io/';
const pageUrl = `${siteUrl}security/`;
const title = 'データの扱いとセキュリティ — ShadowHarness';
const description =
	'Shadow Hubのセキュリティと、Sidera Memoryが送信・保存するデータを説明します。';
---

<SiteLayout
	lang="ja"
	title={title}
	description={description}
	pageUrl={pageUrl}
	alternateJa={pageUrl}
	alternateEn={`${siteUrl}en/security/`}
>
	<main id="main-content" class="guide-page" tabindex="-1">
		<header class="guide-hero">
			<p class="eyebrow">DATA HANDLING &amp; SECURITY</p>
			<h1>データの扱いとセキュリティ</h1>
		</header>

		<div class="guide-layout">
			<aside class="guide-nav">
				<p>このページ</p>
				<nav aria-label="データの扱いに関する目次">
					<a href="#security">Shadow Hubのセキュリティ</a>
					<a href="#data">扱うデータ</a>
				</nav>
			</aside>

			<article class="guide-content prose">
				<section id="security">
					<p class="eyebrow">01 / SERVER SECURITY</p>
					<h2>Shadow Hubのセキュリティ</h2>
					<div class="trust-grid">
						<div>
							<h3>通信はHTTPS</h3>
							<p>PCとShadow Hub間の通信はHTTPSで暗号化します。</p>
						</div>
						<div>
							<h3>利用者ごとに分離</h3>
							<p>
								記憶データは利用者ごとのコンテナ、専用データ領域、内部ネットワークに分離します。
								コンテナはroot権限を使わず、ルートファイルシステムは読み取り専用です。
							</p>
						</div>
						<div>
							<h3>端末ごとに認証</h3>
							<p>
								ログ送信と記憶取得は、端末トークンで認証します。サーバに残すのは
								トークンのSHA-256ハッシュだけで、端末単位で失効できます。
							</p>
						</div>
						<div>
							<h3>公開面を限定</h3>
							<p>
								記憶データのAPIは、ログ送信・記憶取得・根拠取得だけを公開します。
								管理APIは公開せず、認証情報もアクセスログに残しません。
							</p>
						</div>
					</div>
				</section>

				<section id="data">
					<p class="eyebrow">02 / DATA</p>
					<h2>Shadowが扱うデータ</h2>
					<dl class="facts-list">
						<div>
							<dt>利用者のPC</dt>
							<dd>
								各CLIの生ログは、CLIごとの保存先に残ります。生ログには入力、AIの応答、
								コマンド出力などが含まれます。
							</dd>
						</div>
						<div>
							<dt>Shadow Hub</dt>
							<dd>
								Sidera Memoryを有効にすると、生ログの追加分が送られます。Hubは各端末から
								送られた生ログ全文と、そこから作った記憶・索引を保持します。
							</dd>
						</div>
						<div>
							<dt>作業中のAIペイン</dt>
							<dd>
								現在の入力に関係する記憶を、文脈としてAIペインへ渡します。
							</dd>
						</div>
					</dl>
					<p>
						記憶の構造化にはLLMを使います。構造化に渡す入力は、
						モデル学習に利用しない設定で処理します。
					</p>
				</section>

			</article>
		</div>
	</main>
</SiteLayout>
