---
import LandingPage from '../components/LandingPage.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const siteUrl = 'https://shadowharness.github.io/';
const title = 'ShadowHarness — AIエージェントに、ひとつの机と記憶を。';
const description =
	'GPT / Codex、Claude Code、Grok、Geminiなどを一つの画面へ。作業と記憶がAIをまたいでつながる、Windows向け統合LLMターミナル環境。';
---

<SiteLayout
	lang="ja"
	title={title}
	description={description}
	pageUrl={siteUrl}
	alternateJa={siteUrl}
	alternateEn={`${siteUrl}en/`}
>
	<Fragment slot="head-extra">
		<link rel="preload" as="image" href="/media/hero-workspace.webp?v=20260729g" type="image/webp" fetchpriority="high" />
		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				'@context': 'https://schema.org',
				'@type': 'SoftwareApplication',
				name: 'ShadowHarness',
				applicationCategory: 'DeveloperApplication',
				operatingSystem: 'Windows',
				description,
				url: siteUrl,
				image: `${siteUrl}og-image.png?v=20260729e`,
				author: { '@type': 'Organization', name: 'ShadowHarness' },
			})}
		/>
	</Fragment>
	<LandingPage lang="ja" />
</SiteLayout>
